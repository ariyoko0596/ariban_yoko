// src/pages/admin.astro
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase.js';

// 1. CEK OTENTIKASI
const accessToken = Astro.cookies.get('sb-access-token')?.value;
const refreshToken = Astro.cookies.get('sb-refresh-token')?.value;

if (!accessToken || !refreshToken) {
    return Astro.redirect('/login');
}

const { error: authError } = await supabase.auth.setSession({
    access_token: accessToken,
    refresh_token: refreshToken,
});

if (authError) {
    Astro.cookies.delete('sb-access-token', { path: '/' });
    Astro.cookies.delete('sb-refresh-token', { path: '/' });
    return Astro.redirect('/login');
}

// 2. PROSES AKSI FORM (POST)
let pesan = '';
let isError = false;

if (Astro.request.method === 'POST') {
    const formData = await Astro.request.formData();
    const action = formData.get('action')?.toString();
    
    // Logout
    if (formData.has('logout')) {
        await supabase.auth.signOut();
        Astro.cookies.delete('sb-access-token', { path: '/' });
        Astro.cookies.delete('sb-refresh-token', { path: '/' });
        return Astro.redirect('/login');
    }

    // A. UPDATE PENGATURAN SITUS
    if (action === 'update_settings') {
        const siteTitle = formData.get('siteTitle')?.toString();
        const heroBadge = formData.get('heroBadge')?.toString();
        const heroTitle = formData.get('heroTitle')?.toString();
        const heroDescription = formData.get('heroDescription')?.toString();
        const neonColor = formData.get('neonColor')?.toString();
        
        const isMaintenance = formData.get('isMaintenance') === 'on';
        const oldProfileImage = formData.get('oldProfileImage')?.toString() || '';
        const profileFile = formData.get('profileFile');

        let finalProfileImage = oldProfileImage;

        if (profileFile && profileFile.size > 0) {
            if (profileFile.size > 2 * 1024 * 1024) {
                isError = true;
                pesan = "Gagal: Ukuran foto profil terlalu besar! Maksimal 2MB.";
            } else {
                const fileName = `profile-main-${Date.now()}-${profileFile.name.replace(/\s+/g, '_')}`;
                const arrayBuffer = await profileFile.arrayBuffer();
                const buffer = new Uint8Array(arrayBuffer);

                const { error: uploadError } = await supabase.storage
                    .from('media')
                    .upload(fileName, buffer, { contentType: profileFile.type });

                if (uploadError) {
                    isError = true;
                    pesan = `Gagal mengunggah foto profil: ${uploadError.message}`;
                } else {
                    const { data: publicUrlData } = supabase.storage.from('media').getPublicUrl(fileName);
                    finalProfileImage = publicUrlData.publicUrl;
                }
            }
        }

        if (!isError && siteTitle && heroTitle) {
            const { error } = await supabase.from('site_settings').update({
                site_title: siteTitle,
                hero_badge: heroBadge,
                hero_title: heroTitle,
                hero_description: heroDescription,
                neon_color: neonColor,
                profile_image: finalProfileImage,
                is_maintenance: isMaintenance,
                updated_at: new Date()
            }).eq('id', 1);

            if (error) {
                isError = true;
                pesan = `Gagal memperbarui pengaturan: ${error.message}`;
            } else {
                pesan = "Pengaturan website & status maintenance berhasil diperbarui!";
            }
        }
    }

    // B. KELOLA PROYEK (TAMBAH & EDIT)
    if (action === 'add_project') {
        const title = formData.get('title')?.toString();
        const description = formData.get('description')?.toString();
        const techStack = formData.get('techStack')?.toString();
        const urlInput = formData.get('imageUrl')?.toString();
        const file = formData.get('file');

        let finalImageUrl = urlInput || '';

        if (file && file.size > 0) {
            if (file.size > 2 * 1024 * 1024) {
                isError = true;
                pesan = "Gagal: Ukuran gambar proyek terlalu besar! Maksimal 2MB.";
            } else {
                const fileName = `proj-${Date.now()}-${file.name.replace(/\s+/g, '_')}`;
                const arrayBuffer = await file.arrayBuffer();
                const buffer = new Uint8Array(arrayBuffer);

                const { error: uploadError } = await supabase.storage
                    .from('media')
                    .upload(fileName, buffer, { contentType: file.type });

                if (uploadError) {
                    isError = true;
                    pesan = `Gagal mengunggah gambar: ${uploadError.message}`;
                } else {
                    const { data: publicUrlData } = supabase.storage.from('media').getPublicUrl(fileName);
                    finalImageUrl = publicUrlData.publicUrl;
                }
            }
        }

        if (!isError && title && description && techStack) {
            const techArray = techStack.split(',').map(s => s.trim());
            const { error } = await supabase.from('projects').insert([{ 
                title, description, tech_stack: techArray, image_url: finalImageUrl 
            }]);
            if (error) { isError = true; pesan = error.message; } else { pesan = "Proyek baru ditambahkan!"; }
        }
    }

    if (action === 'edit_project') {
        const id = formData.get('id')?.toString();
        const title = formData.get('title')?.toString();
        const description = formData.get('description')?.toString();
        const techStack = formData.get('techStack')?.toString();
        const oldUrl = formData.get('oldUrl')?.toString() || '';
        const file = formData.get('file');

        let finalImageUrl = oldUrl;

        if (file && file.size > 0) {
            if (file.size > 2 * 1024 * 1024) {
                isError = true;
                pesan = "Gagal: Ukuran gambar baru terlalu besar! Maksimal 2MB.";
            } else {
                const fileName = `proj-${Date.now()}-${file.name.replace(/\s+/g, '_')}`;
                const arrayBuffer = await file.arrayBuffer();
                const buffer = new Uint8Array(arrayBuffer);
                const { error: uploadError } = await supabase.storage.from('media').upload(fileName, buffer, { contentType: file.type });
                if (!uploadError) {
                    const { data: publicUrlData } = supabase.storage.from('media').getPublicUrl(fileName);
                    finalImageUrl = publicUrlData.publicUrl;
                } else {
                    isError = true;
                    pesan = `Gagal unggah gambar baru: ${uploadError.message}`;
                }
            }
        }

        if (!isError && id && title && description && techStack) {
            const techArray = techStack.split(',').map(s => s.trim());
            const { error } = await supabase.from('projects').update({ 
                title, description, tech_stack: techArray, image_url: finalImageUrl 
            }).eq('id', id);

            if (error) { 
                isError = true; 
                pesan = `Gagal memperbarui proyek: ${error.message}`; 
            } else { 
                pesan = "Proyek berhasil diperbarui!"; 
            }
        }
    }

    if (action === 'delete_project') {
        const id = formData.get('id')?.toString();
        if (id) {
            const { error } = await supabase.from('projects').delete().eq('id', id);
            if (error) { isError = true; pesan = error.message; } else { pesan = "Proyek dihapus!"; }
        }
    }

    // C. GEAR & STACK
    if (action === 'add_gear') {
        const category = formData.get('category')?.toString();
        const name = formData.get('name')?.toString();
        const description = formData.get('description')?.toString();
        if (category && name && description) {
            const { error } = await supabase.from('hardware_specs').insert([{ category, name, role: description }]);
            if (error) { isError = true; pesan = error.message; } else { pesan = "Gear ditambahkan!"; }
        }
    }
    if (action === 'delete_gear') {
        const id = formData.get('id')?.toString();
        if (id) {
            const { error } = await supabase.from('hardware_specs').delete().eq('id', id);
            if (error) { isError = true; pesan = error.message; } else { pesan = "Gear dihapus!"; }
        }
    }

    // D. CHANGELOG
    if (action === 'add_changelog') {
        const version = formData.get('version')?.toString();
        const content = formData.get('content')?.toString();
        if (version && content) {
            const { error } = await supabase.from('changelogs').insert([{ version, content }]);
            if (error) { isError = true; pesan = error.message; } else { pesan = "Changelog ditambahkan!"; }
        }
    }
    if (action === 'delete_changelog') {
        const id = formData.get('id')?.toString();
        if (id) {
            const { error } = await supabase.from('changelogs').delete().eq('id', id);
            if (error) { isError = true; pesan = error.message; } else { pesan = "Changelog dihapus!"; }
        }
    }

    // E. MEDIA
    if (action === 'add_media') {
        const title = formData.get('title')?.toString();
        const type = formData.get('type')?.toString();
        const description = formData.get('description')?.toString();
        const urlInput = formData.get('url')?.toString();
        const file = formData.get('file');

        let finalUrl = urlInput || '';

        if (file && file.size > 0) {
            if (file.size > 2 * 1024 * 1024) {
                isError = true;
                pesan = "Gagal: Ukuran file media terlalu besar! Maksimal 2MB.";
            } else {
                const fileName = `media-${Date.now()}-${file.name.replace(/\s+/g, '_')}`;
                const arrayBuffer = await file.arrayBuffer();
                const buffer = new Uint8Array(arrayBuffer);
                const { error: uploadError } = await supabase.storage.from('media').upload(fileName, buffer, { contentType: file.type });
                if (!uploadError) {
                    const { data: publicUrlData } = supabase.storage.from('media').getPublicUrl(fileName);
                    finalUrl = publicUrlData.publicUrl;
                }
            }
        }
        if (!isError && title && type && finalUrl) {
            const { error } = await supabase.from('media').insert([{ title, type, url: finalUrl, description }]);
            if (error) { isError = true; pesan = error.message; } else { pesan = "Media ditambahkan!"; }
        }
    }
    if (action === 'delete_media') {
        const id = formData.get('id')?.toString();
        if (id) {
            const { error } = await supabase.from('media').delete().eq('id', id);
            if (error) { isError = true; pesan = error.message; } else { pesan = "Media dihapus!"; }
        }
    }

    // F. GUESTBOOK
    if (action === 'delete_guestbook') {
        const id = formData.get('id')?.toString();
        if (id) {
            const { error } = await supabase.from('guestbook').delete().eq('id', id);
            if (error) { isError = true; pesan = error.message; } else { pesan = "Pesan dihapus!"; }
        }
    }
}

// 3. AMBIL DATA DARI SUPABASE
const { data: currentSettings } = await supabase.from('site_settings').select('*').single();
const { data: projects } = await supabase.from('projects').select('*').order('created_at', { ascending: false });
const { data: gearList } = await supabase.from('hardware_specs').select('*').order('created_at', { ascending: false });
const { data: changelogList } = await supabase.from('changelogs').select('*').order('created_at', { ascending: false });
const { data: mediaList } = await supabase.from('media').select('*').order('created_at', { ascending: false });
const { data: guestbookList } = await supabase.from('guestbook').select('*').order('created_at', { ascending: false });

// Ambil data analitik kunjungan
const { data: analyticsList } = await supabase.from('site_analytics').select('*').order('created_at', { ascending: false }).limit(50);
const totalVisits = analyticsList ? analyticsList.length : 0;
