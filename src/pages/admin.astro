<Layout title="Dashboard Admin | YOKO.">
    <style>
        /* Paksa body halaman admin selalu gelap agar teks selalu terlihat kontras */
        :global(body) {
            background-color: #0b0c10 !important;
            color: #ffffff !important;
        }

        .admin-wrapper {
            display: flex;
            flex-direction: column;
            gap: 32px;
            margin-top: -20px;
        }
        @media (min-width: 768px) {
            .admin-wrapper { flex-direction: row; align-items: flex-start; }
        }
        .admin-sidebar {
            width: 100%;
            background-color: #181a20;
            border: 1px solid #2d313d;
            border-radius: 8px;
            padding: 24px;
            display: flex;
            flex-direction: column;
        }
        @media (min-width: 768px) {
            .admin-sidebar { width: 280px; position: sticky; top: 100px; flex-shrink: 0; }
        }
        .brand-title {
            font-size: 18px;
            font-weight: bold;
            color: #ffffff;
            margin-bottom: 24px;
            padding-bottom: 16px;
            border-bottom: 1px solid #2d313d;
        }
        .brand-title span { color: #eab308; }
        .tab-btn {
            width: 100%;
            text-align: left;
            background: transparent;
            border: none;
            border-left: 2px solid transparent;
            padding: 12px 16px;
            color: #9ca3af;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
            border-radius: 0 4px 4px 0;
            margin-bottom: 4px;
        }
        .tab-btn:hover { color: #ffffff; }
        .tab-btn.active {
            border-left-color: #eab308;
            background-color: rgba(234, 179, 8, 0.1);
            color: #eab308;
            font-weight: bold;
        }
        .sidebar-footer {
            margin-top: 24px;
            padding-top: 16px;
            border-top: 1px solid #2d313d;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .link-text {
            color: #9ca3af;
            font-size: 12px;
            font-family: 'JetBrains Mono', monospace;
            transition: color 0.2s;
        }
        .link-text:hover { color: #eab308; }
        .btn-logout {
            background: none;
            border: none;
            color: #ef4444;
            font-size: 12px;
            font-weight: bold;
            font-family: 'JetBrains Mono', monospace;
            cursor: pointer;
            text-align: left;
            padding: 0;
        }
        .btn-logout:hover { color: #fca5a5; }

        .admin-main { flex: 1; width: 100%; }
        .page-header { margin-bottom: 32px; }
        .page-header h1 { font-size: 28px; font-weight: 800; color: #ffffff; margin-bottom: 8px; }
        .page-header p { font-size: 14px; color: #9ca3af; }

        .alert-box {
            padding: 16px;
            margin-bottom: 24px;
            font-size: 14px;
            font-weight: bold;
            border-left: 4px solid;
            border-radius: 4px;
        }
        .alert-success { background-color: rgba(234, 179, 8, 0.1); border-color: #eab308; color: #eab308; }
        .alert-error { background-color: rgba(239, 68, 68, 0.1); border-color: #ef4444; color: #f87171; }

        .tab-content { display: none; }
        .tab-content.active { display: block; animation: fadeIn 0.3s ease; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

        .card-box {
            background-color: #181a20;
            border: 1px solid #2d313d;
            border-radius: 8px;
            padding: 24px;
            margin-bottom: 32px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }
        .card-title {
            font-size: 18px;
            font-weight: bold;
            color: #eab308;
            margin-bottom: 24px;
            padding-bottom: 12px;
            border-bottom: 1px solid #2d313d;
        }
        .card-title-white { color: #ffffff; font-size: 18px; font-weight: bold; margin-bottom: 16px; }

        .form-row {
            display: grid;
            grid-template-columns: 1fr;
            gap: 16px;
            margin-bottom: 16px;
        }
        @media (min-width: 640px) { .form-row { grid-template-columns: 1fr 1fr; } }
        .form-group { margin-bottom: 16px; }
        label {
            display: block;
            font-size: 12px;
            font-weight: bold;
            color: #9ca3af;
            margin-bottom: 6px;
        }
        input[type="text"], select, textarea {
            width: 100%;
            background-color: #21242d;
            border: 1px solid #2d313d;
            color: #ffffff;
            padding: 12px;
            border-radius: 4px;
            font-family: 'Inter', sans-serif;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s;
        }
        input[type="text"]:focus, select:focus, textarea:focus { border-color: #eab308; }
        input[type="file"] {
            width: 100%;
            background-color: #21242d;
            border: 1px solid #2d313d;
            color: #ffffff;
            font-size: 12px;
            padding: 8px;
            border-radius: 4px;
        }
        input[type="file"]::file-selector-button {
            background-color: #eab308;
            color: #000000;
            border: none;
            padding: 6px 12px;
            margin-right: 12px;
            font-weight: bold;
            border-radius: 2px;
            cursor: pointer;
        }
        .btn-submit {
            width: 100%;
            background-color: #eab308;
            color: #000000;
            font-weight: bold;
            padding: 12px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            transition: opacity 0.2s;
            margin-top: 8px;
        }
        .btn-submit:hover { opacity: 0.9; }

        .list-item {
            border: 1px solid #2d313d;
            background-color: #21242d;
            padding: 16px;
            border-radius: 6px;
            margin-bottom: 16px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }
        .list-badge {
