                    <input type="hidden" name="logout" value="true" />
                    <button type="submit" class="btn-logout">🚪 KELUAR (LOGOUT)</button>
                </form>
            </div>
        </aside>

        <main class="admin-main">
            <div class="page-header">
                <h1>Panel Kontrol Admin</h1>
                <p>Kelola seluruh komponen portofolio secara modular & terfokus.</p>
            </div>

            {pesan && (
                <div class={`alert-box ${isError ? 'alert-error' : 'alert-success'}`}>
                    {pesan}
                </div>
            )}

            <!-- TAB 1: PENGATURAN -->
            <div id="tab-settings" class="tab-content active">
                <div class="card-box">
                    <h2 class="card-title">⚙️ Pengaturan Website & Profil</h2>
                    <form method="POST" enctype="multipart/form-data">
                        <input type="hidden" name="action" value="update_settings" />
                        <input type="hidden" name="oldProfileImage" value={currentSettings?.profile_image || ''} />

