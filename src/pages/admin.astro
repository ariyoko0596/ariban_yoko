                <button onclick="window.switchTab('guestbook')" id="btn-guestbook" class="tab-btn">📖 Buku Tamu</button>
                <button onclick="window.switchTab('analytics')" id="btn-analytics" class="tab-btn">📈 Analitik & Pengunjung</button>
            </nav>
            <div class="sidebar-footer">
                <a href="/" target="_blank" class="link-text">↗ Lihat Website Utama</a>
