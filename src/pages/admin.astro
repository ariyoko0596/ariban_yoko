            font-family: 'JetBrains Mono', monospace;
            background-color: rgba(234, 179, 8, 0.1);
            color: #eab308;
            padding: 2px 6px;
            border-radius: 2px;
            text-transform: uppercase;
            margin-right: 8px;
        }
        .list-title { font-size: 14px; font-weight: bold; color: #ffffff; margin-bottom: 4px; }
        .list-desc { font-size: 12px; color: #9ca3af; }
        .btn-edit { background-color: #3b82f6; color: #ffffff; padding: 8px 16px; border: none; border-radius: 4px; font-size: 12px; font-weight: bold; cursor: pointer; }
        .btn-delete { background-color: #ef4444; color: #ffffff; padding: 6px 12px; border: none; border-radius: 4px; font-size: 11px; font-weight: bold; cursor: pointer; }

        .profile-box {
            display: flex;
            flex-direction: column;
            gap: 24px;
            padding: 16px;
            border: 1px solid #2d313d;
            background-color: #21242d;
            border-radius: 6px;
            margin-bottom: 24px;
        }
        @media (min-width: 640px) { .profile-box { flex-direction: row; align-items: center; } }
        .profile-avatar {
            width: 80px; height: 80px;
            border-radius: 50%;
            border: 2px solid #4b5563;
            background-color: #000;
            overflow: hidden;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }
        .profile-avatar img { width: 100%; height: 100%; object-fit: cover; }
    </style>

    <div class="admin-wrapper">
        
        <aside class="admin-sidebar">
            <div class="brand-title">CMS<span>.</span>DASHBOARD</div>
            <nav>
                <button onclick="window.switchTab('settings')" id="btn-settings" class="tab-btn active">⚙️ Pengaturan Website</button>
                <button onclick="window.switchTab('projects')" id="btn-projects" class="tab-btn">📁 Kelola Proyek</button>
                <button onclick="window.switchTab('gear')" id="btn-gear" class="tab-btn">💻 Gear & Stack</button>
                <button onclick="window.switchTab('changelog')" id="btn-changelog" class="tab-btn">⚡ Changelog</button>
