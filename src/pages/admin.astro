                        <div class="form-row">
                            <div class="form-group">
                                <label>Judul Tab Browser (Title)</label>
                                <input type="text" name="siteTitle" value={currentSettings?.site_title || ''} required />
                            </div>
                            <div class="form-group">
                                <label>Label Badge Hero Atas</label>
                                <input type="text" name="heroBadge" value={currentSettings?.hero_badge || ''} required />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Judul Utama Hero (Heading)</label>
                            <input type="text" name="heroTitle" value={currentSettings?.hero_title || ''} required />
                        </div>
                        <div class="form-group">
                            <label>Deskripsi Singkat Hero</label>
                            <textarea name="heroDescription" rows="3" required>{currentSettings?.hero_description || ''}</textarea>
                        </div>
                        <div class="form-group">
                            <label>Warna Aksen Utama (HEX Code)</label>
                            <input type="text" name="neonColor" value={currentSettings?.neon_color || '#eab308'} required style="font-family: monospace;" />
                        </div>
                        <button type="submit" class="btn-submit">Simpan Perubahan Pengaturan</button>
                    </form>
                </div>
            </div>

            <!-- TAB 2: PROYEK -->
            <div id="tab-projects" class="tab-content">
                <div class="card-box">
                    <h2 class="card-title">＋ Tambah Proyek Baru</h2>
                    <form method="POST" enctype="multipart/form-data">
                        <input type="hidden" name="action" value="add_project" />
                        <div class="form-row">
                            <div class="form-group">
                                <label>Nama Proyek</label>
                                <input type="text" name="title" required />
                            </div>
                            <div class="form-group">
                                <label>Upload Gambar Proyek (Maks 2MB)</label>
                                <input type="file" name="file" accept="image/*" />
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Deskripsi / Dokumentasi Sistem <span style="color: #6b7280; font-weight: normal;">(Mendukung Markdown: ## Judul, **Tebal**, `code`, - Poin)</span></label>
                            <textarea name="description" rows="4" required placeholder="Tulis dokumentasi dalam format Markdown..."></textarea>
                        </div>
                        <div class="form-group">
                            <label>Tech Stack (Pisahkan dengan koma)</label>
                            <input type="text" name="techStack" required placeholder="Python, Celery, Redis" />
                        </div>
                        <button type="submit" class="btn-submit">Simpan Proyek Baru</button>
                    </form>
                </div>

                <h3 class="card-title-white">Daftar Proyek Tersimpan</h3>
                {projects && projects.length > 0 ? projects.map(proj => (
                    <div class="list-item">
                        <form method="POST" enctype="multipart/form-data">
                            <input type="hidden" name="action" value="edit_project" />
                            <input type="hidden" name="id" value={proj.id} />
                            <input type="hidden" name="oldUrl" value={proj.image_url || ''} />
                            
                            <div class="form-row">
                                <div class="form-group"><label>Judul</label><input type="text" name="title" value={proj.title} required /></div>
                                <div class="form-group"><label>Tech Stack</label><input type="text" name="techStack" value={Array.isArray(proj.tech_stack) ? proj.tech_stack.join(', ') : proj.tech_stack} required /></div>
                            </div>
                            <div class="form-group"><label>Ganti Gambar (Opsional, Maks 2MB)</label><input type="file" name="file" accept="image/*" /></div>
                            <div class="form-group"><label>Deskripsi (Markdown)</label><textarea name="description" rows="3" required>{proj.description}</textarea></div>
                            <div style="display: flex; justify-content: flex-end;"><button type="submit" class="btn-edit">Perbarui Proyek</button></div>
                        </form>
                        <form method="POST" onsubmit="return confirm('Hapus proyek ini?');" style="border-top: 1px solid #2d313d; padding-top: 12px; display: flex; justify-content: flex-end;">
                            <input type="hidden" name="action" value="delete_project" />
                            <input type="hidden" name="id" value={proj.id} />
                            <button type="submit" class="btn-delete">Hapus Proyek</button>
                        </form>
                    </div>
                )) : <p style="color: #6b7280; font-size: 14px;">Belum ada proyek.</p>}
            </div>

            <!-- TAB 3: GEAR -->
            <div id="tab-gear" class="tab-content">
                <div class="card-box">
                    <h2 class="card-title">💻 Tambah Gear & Workstation</h2>
                    <form method="POST">
                        <input type="hidden" name="action" value="add_gear" />
                        <div class="form-row">
                            <div class="form-group"><label>Kategori</label><input type="text" name="category" required /></div>
                            <div class="form-group"><label>Nama Perangkat</label><input type="text" name="name" required /></div>
                        </div>
                        <div class="form-group"><label>Deskripsi / Peran</label><textarea name="description" rows="2" required></textarea></div>
                        <button type="submit" class="btn-submit">Simpan Gear Baru</button>
                    </form>
                </div>
                <h3 class="card-title-white">Daftar Gear Tersimpan</h3>
                {gearList && gearList.length > 0 ? gearList.map(gear => (
                    <div class="list-item" style="flex-direction: row; justify-content: space-between; align-items: center;">
                        <div>
                            <span class="list-badge">{gear.category}</span>
                            <div class="list-title">{gear.name}</div>
                            <div class="list-desc">{gear.role}</div>
                        </div>
                        <form method="POST" onsubmit="return confirm('Hapus gear?');">
                            <input type="hidden" name="action" value="delete_gear" />
                            <input type="hidden" name="id" value={gear.id} />
                            <button type="submit" class="btn-delete">Hapus</button>
                        </form>
                    </div>
                )) : <p style="color: #6b7280; font-size: 14px;">Belum ada gear.</p>}
            </div>

            <!-- TAB 4: CHANGELOG -->
            <div id="tab-changelog" class="tab-content">
                <div class="card-box">
                    <h2 class="card-title">⚡ Tambah Changelog</h2>
                    <form method="POST">
                        <input type="hidden" name="action" value="add_changelog" />
                        <div class="form-group"><label>Versi / Tag</label><input type="text" name="version" required placeholder="v1.0.0" /></div>
                        <div class="form-group"><label>Isi Pembaruan</label><textarea name="content" rows="3" required></textarea></div>
                        <button type="submit" class="btn-submit">Simpan Changelog</button>
                    </form>
                </div>
                <h3 class="card-title-white">Riwayat Changelog</h3>
                {changelogList && changelogList.length > 0 ? changelogList.map(log => (
                    <div class="list-item" style="flex-direction: row; justify-content: space-between; align-items: center;">
                        <div>
                            <span class="list-badge">{log.version}</span>
                            <div class="list-desc" style="margin-top: 4px; color: #d1d5db;">{log.content}</div>
                        </div>
                        <form method="POST" onsubmit="return confirm('Hapus changelog?');">
                            <input type="hidden" name="action" value="delete_changelog" />
                            <input type="hidden" name="id" value={log.id} />
                            <button type="submit" class="btn-delete">Hapus</button>
                        </form>
                    </div>
                )) : <p style="color: #6b7280; font-size: 14px;">Belum ada changelog.</p>}
            </div>

            <!-- TAB 5: MEDIA -->
            <div id="tab-media" class="tab-content">
                <div class="card-box">
                    <h2 class="card-title">🖼️ Tambah Media</h2>
                    <form method="POST" enctype="multipart/form-data">
                        <input type="hidden" name="action" value="add_media" />
                        <div class="form-row">
                            <div class="form-group"><label>Judul Media</label><input type="text" name="title" required /></div>
                            <div class="form-group">
                                <label>Tipe</label>
                                <select name="type">
                                    <option value="photo">Foto</option>
                                    <option value="video">Video</option>
                                </select>
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group"><label>Upload File (Maks 2MB)</label><input type="file" name="file" accept="image/*" /></div>
                            <div class="form-group"><label>Atau URL</label><input type="text" name="url" /></div>
                        </div>
                        <button type="submit" class="btn-submit">Simpan Media</button>
                    </form>
                </div>
                <h3 class="card-title-white">Daftar Media</h3>
                {mediaList && mediaList.length > 0 ? mediaList.map(med => (
                    <div class="list-item" style="flex-direction: row; justify-content: space-between; align-items: center;">
                        <div>
                            <div class="list-title">{med.title}</div>
                            <div class="list-desc">{med.url}</div>
                        </div>
                        <form method="POST" onsubmit="return confirm('Hapus media?');">
                            <input type="hidden" name="action" value="delete_media" />
                            <input type="hidden" name="id" value={med.id} />
                            <button type="submit" class="btn-delete">Hapus</button>
                        </form>
                    </div>
                )) : <p style="color: #6b7280; font-size: 14px;">Belum ada media.</p>}
            </div>

            <!-- TAB 6: GUESTBOOK -->
            <div id="tab-guestbook" class="tab-content">
                <h3 class="card-title-white">📖 Kelola Buku Tamu</h3>
                {guestbookList && guestbookList.length > 0 ? guestbookList.map(entry => (
                    <div class="list-item" style="flex-direction: row; justify-content: space-between; align-items: center;">
                        <div>
                            <div class="list-title">{entry.name}</div>
                            <div class="list-desc" style="color: #d1d5db;">{entry.message}</div>
                        </div>
                        <form method="POST" onsubmit="return confirm('Hapus pesan ini?');">
                            <input type="hidden" name="action" value="delete_guestbook" />
                            <input type="hidden" name="id" value={entry.id} />
                            <button type="submit" class="btn-delete">Hapus</button>
                        </form>
                    </div>
                )) : <p style="color: #6b7280; font-size: 14px;">Belum ada pesan.</p>}
            </div>

            <!-- TAB 7: ANALITIK KUNJUNGAN -->
            <div id="tab-analytics" class="tab-content">
                <div class="card-box">
                    <h2 class="card-title">📈 Statistik & Pelacakan Pengunjung</h2>
                    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 24px;">
                        <div style="background: #21242d; padding: 20px; border-radius: 6px; border: 1px solid #2d313d;">
                            <span style="font-size: 11px; font-family: 'JetBrains Mono', monospace; color: #9ca3af; text-transform: uppercase;">Total Kunjungan Tercatat</span>
                            <div style="font-size: 32px; font-weight: 800; color: #eab308; margin-top: 4px;">{totalVisits}</div>
                        </div>
                        <div style="background: #21242d; padding: 20px; border-radius: 6px; border: 1px solid #2d313d;">
                            <span style="font-size: 11px; font-family: 'JetBrains Mono', monospace; color: #9ca3af; text-transform: uppercase;">Status Pelacakan</span>
                            <div style="font-size: 14px; font-weight: bold; color: #10b981; margin-top: 8px;">● Aktif & Real-time</div>
                        </div>
                    </div>

                    <h3 class="card-title-white" style="font-size: 14px; margin-bottom: 12px;">Log Aktivitas Kunjungan Terbaru</h3>
                    <div style="display: flex; flex-direction: column; gap: 8px; max-height: 350px; overflow-y: auto;">
                        {analyticsList && analyticsList.length > 0 ? (
                            analyticsList.map((log) => (
                                <div style="background: #0b0c10; border: 1px solid #2d313d; padding: 12px; border-radius: 4px; display: flex; justify-content: space-between; align-items: center; font-size: 12px;">
                                    <div>
                                        <span style="color: #eab308; font-family: 'JetBrains Mono', monospace; font-weight: bold; margin-right: 8px;">[{log.page}]</span>
                                        <span style="color: #9ca3af; word-break: break-all;">{log.user_agent}</span>
                                    </div>
                                    <span style="font-family: 'JetBrains Mono', monospace; color: #9ca3af; white-space: nowrap; margin-left: 12px;">
                                        {new Date(log.created_at).toLocaleTimeString('id-ID')}
                                    </span>
                                </div>
                            ))
                        ) : (
                            <p style="font-size: 12px; font-family: monospace; color: #9ca3af;">Belum ada data kunjungan terekam.</p>
                        )}
                    </div>
                </div>
            </div>

        </main>
    </div>

    <!-- Skrip Interaktif Khusus Halaman Admin -->
    <script is:inline>
        document.addEventListener('astro:page-load', () => {
            // Paksa tema dokumen menjadi dark saat di halaman admin
            document.documentElement.setAttribute('data-theme', 'dark');

            // Daftarkan fungsi switchTab ke global window agar bisa dipanggil dari inline HTML
            window.switchTab = function(tabName) {
                document.querySelectorAll('.tab-content').forEach(el => {
                    el.classList.remove('active');
                });
                document.querySelectorAll('.tab-btn').forEach(btn => {
                    btn.classList.remove('active');
                });
                
                const targetTab = document.getElementById('tab-' + tabName);
                if (targetTab) targetTab.classList.add('active');
                
                const activeBtn = document.getElementById('btn-' + tabName);
                if (activeBtn) activeBtn.classList.add('active');
                
                localStorage.setItem('active_admin_tab', tabName);
            };

            // Inisialisasi tab aktif saat dimuat
            const savedTab = localStorage.getItem('active_admin_tab') || 'settings';
            
            // Pastikan tab yang tersimpan benar-benar ada di DOM sebelum diswitch
            if (document.getElementById('tab-' + savedTab)) {
                window.switchTab(savedTab);
            }
        });
    </script>
</Layout>