---
// src/pages/index.astro
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import TerminalPlayground from '../components/TerminalPlayground.astro'; // <--- Impor Terminal Playground
import { supabase } from '../lib/supabase.js';

// 1. Catat Kunjungan Otomatis (Analytics Tracker)
try {
    await supabase.from('site_analytics').insert([
        { page: '/', user_agent: Astro.request.headers.get('user-agent') || 'Unknown' }
    ]);
} catch (e) {
    // Abaikan error jika tabel belum dibuat agar tidak merusak beranda
}

const { data: settings } = await supabase.from('site_settings').select('*').single();

// 2. Cek Mode Pemeliharaan (Maintenance Mode)
if (settings?.is_maintenance) {
    return Astro.redirect('/maintenance');
}

// 3. Tangkap Input POST dari Buku Tamu (Guestbook)
let guestMessageStatus = '';
let isGuestError = false;

if (Astro.request.method === 'POST') {
    const formData = await Astro.request.formData();
    const formAction = formData.get('form_action')?.toString();

    if (formAction === 'add_guestbook') {
        const name = formData.get('guest_name')?.toString().trim();
        const message = formData.get('guest_message')?.toString().trim();

        if (!name || !message) {
            isGuestError = true;
            guestMessageStatus = 'Nama dan pesan wajib diisi!';
        } else {
            const { error } = await supabase.from('guestbook').insert([
                { name, message }
            ]);

            if (error) {
                isGuestError = true;
                guestMessageStatus = `Gagal mengirim pesan: ${error.message}`;
            } else {
                isGuestError = false;
                guestMessageStatus = 'Pesan Anda berhasil dikirim ke Buku Tamu!';
            }
        }
    }
}

// 4. Kueri Data Beranda
const { data: projects } = await supabase.from('projects').select('*').order('created_at', { ascending: false }).limit(6);
const { data: hardwareSpecs } = await supabase.from('hardware_specs').select('*').order('created_at', { ascending: true });
const { data: mediaList } = await supabase.from('media').select('*').order('created_at', { ascending: false }).limit(6);
const { data: guestbookList } = await supabase.from('guestbook').select('*').order('created_at', { ascending: false }).limit(5);

const siteConfig = settings || {
    site_title: 'Ariban Yoko — Backend Engineer & Streamer',
    hero_title: 'Backend Developer, TikTok Live Streamer',
    hero_description: 'Merakit arsitektur backend berperforma tinggi dengan Python, Celery, & Redis, sekaligus menyiarkan aksi kompetitif Mobile Legends setiap hari.',
};
---

<Layout title={siteConfig.site_title} description={siteConfig.hero_description}>
    <style>
        .hero-section {
            padding: 20px 0 80px 0;
            display: grid;
            grid-template-columns: 1fr 320px 1fr;
            gap: 40px;
            align-items: center;
        }
        @media (max-width: 900px) {
            .hero-section { grid-template-columns: 1fr; text-align: center; }
        }
        .hero-left h1 {
            font-size: 52px;
            font-weight: 800;
            color: var(--text-main);
            line-height: 1.1;
            margin-bottom: 24px;
        }
        .hero-left h1 span { color: var(--accent-color); }
        .social-links { font-size: 12px; font-family: 'JetBrains Mono', monospace; color: var(--text-muted); margin-bottom: 24px; }
        .btn-contact {
            display: inline-block;
            padding: 12px 28px;
            border: 2px solid var(--accent-color);
            color: var(--accent-color);
            font-weight: bold;
            font-size: 12px;
            letter-spacing: 1px;
            text-transform: uppercase;
            border-radius: 4px;
            transition: all 0.2s;
        }
        .btn-contact:hover { background-color: var(--accent-color); color: var(--bg-main); }

        .hero-center { display: flex; justify-content: center; }
        .profile-wrapper {
            width: 280px;
            height: 280px;
            border-radius: 50%;
            overflow: hidden;
            background: var(--bg-card);
            border: 2px solid var(--border-color);
            box-shadow: 0 25px 50px rgba(0,0,0,0.15);
            padding: 4px;
        }
        .profile-wrapper img { width: 100%; height: 100%; object-fit: cover; border-radius: 50%; }

        .hero-right span.intro-tag {
            font-size: 10px;
            font-family: 'JetBrains Mono', monospace;
            color: var(--accent-color);
            letter-spacing: 2px;
            text-transform: uppercase;
            display: block;
            margin-bottom: 12px;
            font-weight: bold;
        }
        .hero-right h2 { font-size: 22px; font-weight: bold; color: var(--text-main); margin-bottom: 16px; line-height: 1.4; }
        .hero-right p { font-size: 14px; line-height: 1.6; color: var(--text-muted); margin-bottom: 20px; }

        .services-section {
            background-color: var(--bg-card);
            padding: 90px 0;
            border-top: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
            width: 100vw;
            margin-left: calc(50% - 50vw);
        }
        .services-container { max-width: 1050px; margin: 0 auto; padding: 0 32px; }
        .section-title-wrap { text-align: center; max-width: 600px; margin: 0 auto 60px auto; }
        .section-title-wrap span { font-size: 10px; font-family: 'JetBrains Mono', monospace; color: var(--accent-color); letter-spacing: 2px; text-transform: uppercase; display: block; margin-bottom: 10px; font-weight: bold; }
        .section-title-wrap h2 { font-size: 32px; font-weight: bold; color: var(--text-main); margin-bottom: 12px; }
        .section-title-wrap p { font-size: 14px; color: var(--text-muted); }

        .services-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 60px; }
        @media (max-width: 768px) { .services-grid { grid-template-columns: 1fr; } }
        
        .service-card {
            background-color: var(--bg-service);
            border: 1px solid var(--border-color);
            padding: 40px 30px;
            text-align: center;
            border-radius: 8px;
            transition: border-color 0.2s, transform 0.2s;
        }
        .service-card:hover { border-color: var(--accent-color); transform: translateY(-5px); }
        .service-card.highlight { border-color: var(--accent-color); box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
        .service-icon { font-size: 32px; color: var(--accent-color); margin-bottom: 20px; }
        .service-card h3 { font-size: 17px; font-weight: bold; color: var(--text-main); margin-bottom: 8px; }
        .service-card h3.highlight-text { color: var(--accent-color); }
        .service-card p { font-size: 12px; font-family: 'JetBrains Mono', monospace; color: var(--text-muted); }

        .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; text-align: center; border-top: 1px solid var(--border-color); padding-top: 40px; }
        .stat-item .stat-num { font-size: 36px; font-weight: 800; color: var(--accent-color); margin-bottom: 4px; }
        .stat-item .stat-label { font-size: 11px; font-family: 'JetBrains Mono', monospace; text-transform: uppercase; color: var(--text-muted); }

        .content-section { max-width: 1050px; margin: 0 auto; padding: 70px 0; border-top: 1px solid var(--border-color); }
        .content-header { margin-bottom: 40px; }
        .content-header span { font-size: 10px; font-family: 'JetBrains Mono', monospace; color: var(--accent-color); letter-spacing: 2px; text-transform: uppercase; display: block; margin-bottom: 10px; font-weight: bold; }
        .content-header h2 { font-size: 32px; font-weight: bold; color: var(--text-main); }

        .projects-list { display: flex; flex-direction: column; gap: 24px; }
        .project-card {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 24px;
            border-radius: 8px;
            display: flex;
            gap: 24px;
            align-items: center;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }
        .project-card:hover { border-color: var(--accent-color); transform: translateY(-3px); }
        @media (max-width: 768px) { .project-card { flex-direction: column; align-items: flex-start; } }
        .project-img { width: 220px; height: 130px; background: var(--bg-service); border-radius: 6px; overflow: hidden; flex-shrink: 0; display: flex; align-items: center; justify-content: center; border: 1px solid var(--border-color); }
        .project-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease; }
        .project-card:hover .project-img img { transform: scale(1.05); }
        .project-info h3 { font-size: 18px; font-weight: bold; color: var(--text-main); margin-bottom: 8px; }
        .project-info p { 
            font-size: 13px; 
            color: var(--text-muted); 
            margin-bottom: 12px; 
            line-height: 1.5;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
        .project-link { font-size: 12px; color: var(--accent-color); font-weight: 600; font-family: 'JetBrains Mono', monospace; transition: opacity 0.2s; }
        .project-link:hover { opacity: 0.8; }

        .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
        @media (max-width: 768px) { .grid-2, .grid-3 { grid-template-columns: 1fr; } }
        
        .card-box { background-color: var(--bg-card); border: 1px solid var(--border-color); padding: 24px; border-radius: 8px; transition: border-color 0.2s; }
        .card-box:hover { border-color: var(--accent-color); }
        .card-box strong { display: block; font-size: 14px; color: var(--text-main); margin-bottom: 6px; }
        .card-box span { font-size: 12px; font-family: 'JetBrains Mono', monospace; color: var(--accent-color); }

        .contact-box {
            background-color: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 60px 40px;
            text-align: center;
            border-radius: 12px;
        }
        .contact-box span { font-size: 10px; font-family: 'JetBrains Mono', monospace; color: var(--accent-color); letter-spacing: 2px; text-transform: uppercase; display: block; margin-bottom: 10px; font-weight: bold; }
        .contact-box h2 { font-size: 28px; font-weight: bold; color: var(--text-main); margin-bottom: 15px; }
        .contact-box p { font-size: 14px; max-width: 500px; margin: 0 auto 30px auto; color: var(--text-muted); line-height: 1.6; }
        .contact-buttons { display: flex; justify-content: center; gap: 15px; flex-wrap: wrap; }
        .btn-action { padding: 12px 24px; font-weight: bold; font-size: 12px; border-radius: 4px; text-transform: uppercase; transition: all 0.2s; }
        .btn-action.primary { background: var(--accent-color); color: var(--bg-main); }
        .btn-action.primary:hover { transform: translateY(-2px); box-shadow: 0 4px 12px rgba(234, 179, 8, 0.3); }
        .btn-action.secondary { background: var(--bg-service); color: var(--text-main); border: 1px solid var(--border-color); }
        .btn-action.secondary:hover { border-color: var(--accent-color); color: var(--accent-color); }
    </style>

    <!-- HERO SECTION -->
    <section class="hero-section reveal">
        <div class="hero-left">
            <h1>Ariban<br>Yoko<span>.</span></h1>
            <div class="social-links">
                <a href="https://instagram.com" target="_blank">Instagram</a> | 
                <a href="https://linkedin.com" target="_blank">LinkedIn</a><br>
                <span>Behance</span> | <span>Dribbble</span>
            </div>
            <a href="#contact" class="btn-contact">CONTACT ME</a>
        </div>

        <div class="hero-center">
            <div class="profile-wrapper">
                {settings?.profile_image ? (
                    <img src={settings.profile_image} alt="Profile" loading="lazy" decoding="async" />
                ) : (
                    <div style="display: flex; align-items: center; justify-content: center; height: 100%; font-size: 11px; font-family: monospace; text-align: center; padding: 10px;">[ Atur Foto di /admin ]</div>
                )}
            </div>
        </div>

        <div class="hero-right">
            <span class="intro-tag">{settings?.hero_badge || 'INTRODUCTION'}</span>
            <h2>{siteConfig.hero_title}</h2>
            <p>{siteConfig.hero_description}</p>
            <a href="#services" style="font-size: 13px; color: var(--accent-color); font-weight: bold;">Learn More ↓</a>
        </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="services-section">
        <div class="services-container">
            <div class="section-title-wrap reveal">
                <span>SERVICES</span>
                <h2>What I Am Great At</h2>
                <p>Kombinasi keahlian teknis tingkat lanjut dalam merancang sistem backend berperforma tinggi dan pengelolaan siaran langsung gaming secara profesional.</p>
            </div>

            <div class="services-grid reveal">
                <div class="service-card">
                    <div class="service-icon">✒️</div>
                    <h3>Backend Architecture</h3>
                    <p>129 projects</p>
                </div>
                <div class="service-card highlight">
                    <div class="service-icon">&lt;&gt;</div>
                    <h3 class="highlight-text">Web Development</h3>
                    <p>221 projects</p>
                </div>
                <div class="service-card">
                    <div class="service-icon">📊</div>
                    <h3>Marketing</h3>
                    <p>129 projects</p>
                </div>
            </div>

            <div class="stats-grid reveal">
                <div class="stat-item">
                    <div class="stat-num">09+</div>
                    <div class="stat-label">Years of Experience</div>
                </div>
                <div class="stat-item">
                    <div class="stat-num">200+</div>
                    <div class="stat-label">Satisfied Clients</div>
                </div>
                <div class="stat-item">
                    <div class="stat-num">978+</div>
                    <div class="stat-label">Piece of Designs</div>
                </div>
            </div>
        </div>
    </section>

    <!-- PORTFOLIO -->
    <section id="portfolio" class="content-section">
        <div class="content-header reveal">
            <span>PORTFOLIO</span>
            <h2>Featured Projects & Systems</h2>
        </div>

        <div class="portfolio-controls reveal" style="margin-bottom: 24px; display: flex; flex-direction: column; gap: 16px;">
            <input 
                type="text" 
                id="projectSearch" 
                placeholder="Cari berdasarkan nama proyek atau teknologi..." 
                style="width: 100%; background-color: var(--bg-card); border: 1px solid var(--border-color); color: var(--text-main); padding: 12px 16px; border-radius: 6px; font-family: 'Inter', sans-serif; font-size: 14px; outline: none;"
            />
            <div id="techFilters" style="display: flex; flex-wrap: wrap; gap: 8px;">
                <button class="filter-btn active" data-tech="all" style="font-size: 11px; font-family: 'JetBrains Mono', monospace; padding: 6px 12px; background-color: var(--accent-color); color: var(--bg-main); border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">ALL</button>
                <button class="filter-btn" data-tech="python" style="font-size: 11px; font-family: 'JetBrains Mono', monospace; padding: 6px 12px; background-color: var(--bg-card); color: var(--text-muted); border: 1px solid var(--border-color); border-radius: 4px; cursor: pointer;">PYTHON</button>
                <button class="filter-btn" data-tech="celery" style="font-size: 11px; font-family: 'JetBrains Mono', monospace; padding: 6px 12px; background-color: var(--bg-card); color: var(--text-muted); border: 1px solid var(--border-color); border-radius: 4px; cursor: pointer;">CELERY</button>
                <button class="filter-btn" data-tech="redis" style="font-size: 11px; font-family: 'JetBrains Mono', monospace; padding: 6px 12px; background-color: var(--bg-card); color: var(--text-muted); border: 1px solid var(--border-color); border-radius: 4px; cursor: pointer;">REDIS</button>
                <button class="filter-btn" data-tech="astro" style="font-size: 11px; font-family: 'JetBrains Mono', monospace; padding: 6px 12px; background-color: var(--bg-card); color: var(--text-muted); border: 1px solid var(--border-color); border-radius: 4px; cursor: pointer;">ASTRO</button>
            </div>
        </div>

        <div class="projects-list reveal" id="projectsContainer">
            {projects && projects.length > 0 ? (
                projects.map((proj) => {
                    const techString = Array.isArray(proj.tech_stack) ? proj.tech_stack.join(', ') : (proj.tech_stack || '');
                    
                    const cleanDesc = proj.description 
                        ? proj.description.replace(/[#_*`>\[\]()-]/g, '').trim() 
                        : '';
                    
                    const shortDesc = cleanDesc.length > 130 
                        ? cleanDesc.substring(0, 130) + '...' 
                        : cleanDesc;

                    return (
                        <div class="project-card" data-title={proj.title.toLowerCase()} data-tech={techString.toLowerCase()}>
                            <div class="project-img">
                                {proj.image_url ? <img src={proj.image_url} alt={proj.title} loading="lazy" decoding="async" /> : <span style="font-size:11px; font-family:monospace; color:var(--accent-color);">[ Proyek ]</span>}
                            </div>
                            <div class="project-info" style="flex: 1;">
                                <span style="font-size: 10px; font-family: monospace; color: var(--accent-color); text-transform: uppercase; display: block; margin-bottom: 4px;">{techString}</span>
                                <h3>{proj.title}</h3>
                                <p>{shortDesc}</p>
                                <a href={`/projects/${proj.id}`} class="project-link">View System Architecture →</a>
                            </div>
                        </div>
                    );
                })
            ) : (
                <p style="font-size: 13px; font-family: monospace;">Belum ada proyek tersimpan.</p>
            )}
        </div>
    </section>

    <!-- TERMINAL PLAYGROUND SECTION -->
    <section class="content-section">
        <div class="content-header reveal">
            <span>INTERACTIVE CLI</span>
            <h2>Backend Server Simulation</h2>
        </div>
        <TerminalPlayground />
    </section>

    <!-- WORKSTATION -->
    <section class="content-section">
        <div class="content-header reveal">
            <span>WORKSTATION</span>
            <h2>Hardware & Setup Utama</h2>
        </div>
        <div class="grid-2 reveal">
            {hardwareSpecs?.map((hw) => (
                <div class="card-box">
                    <strong>{hw.name}</strong>
                    <span>{hw.role}</span>
                </div>
            ))}
        </div>
    </section>

    <!-- ARSIP MEDIA -->
    <section class="content-section">
        <div class="content-header reveal">
            <span>GALLERY & MEDIA</span>
            <h2>Arsip Media & Dokumentasi</h2>
        </div>
        <div class="grid-3 reveal">
            {mediaList && mediaList.length > 0 ? (
                mediaList.map((med) => (
                    <div class="card-box" style="padding: 0; overflow: hidden;">
                        <div style="height: 160px; background: var(--bg-service);">
                            {med.url ? <img src={med.url} alt={med.title} loading="lazy" decoding="async" style="width: 100%; height: 100%; object-fit: cover;" /> : null}
                        </div>
                        <div style="padding: 15px;"><h3 style="color: var(--text-main); font-size: 14px; font-weight: bold;">{med.title}</h3></div>
                    </div>
                ))
            ) : (
                <p style="font-size: 13px; font-family: monospace;">Belum ada arsip media.</p>
            )}
        </div>
    </section>

    <!-- GUESTBOOK (BUKU TAMU PUBLIK) -->
    <section class="content-section" id="guestbook">
        <div class="content-header reveal">
            <span>GUESTBOOK</span>
            <h2>Tinggalkan Pesan & Sapaan</h2>
        </div>

        <div class="reveal" style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start;">
            <!-- Form Input Buku Tamu -->
            <div class="card-box">
                <h3 style="font-size: 16px; font-weight: bold; color: var(--text-main); margin-bottom: 16px;">Tulis Pesan Anda</h3>
                
                {guestMessageStatus && (
                    <div style={`padding: 12px; margin-bottom: 16px; font-size: 12px; border-radius: 4px; background: ${isGuestError ? 'rgba(239, 68, 68, 0.1)' : 'rgba(234, 179, 8, 0.1)'}; color: ${isGuestError ? '#ef4444' : 'var(--accent-color)'}; border: 1px solid ${isGuestError ? '#ef4444' : 'var(--accent-color)'};`}>
                        {guestMessageStatus}
                    </div>
                )}

                <form method="POST">
                    <input type="hidden" name="form_action" value="add_guestbook" />
                    <div style="margin-bottom: 14px;">
                        <label style="display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 6px; font-weight: bold;">Nama / Panggilan</label>
                        <input type="text" name="guest_name" required placeholder="Contoh: Alex Developer" style="width: 100%; background: var(--bg-service); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px; border-radius: 4px; font-size: 13px; outline: none;" />
                    </div>
                    <div style="margin-bottom: 16px;">
                        <label style="display: block; font-size: 12px; color: var(--text-muted); margin-bottom: 6px; font-weight: bold;">Pesan & Kesan</label>
                        <textarea name="guest_message" rows="4" required placeholder="Tulis sapaan atau pesan untuk portofolio ini..." style="width: 100%; background: var(--bg-service); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px; border-radius: 4px; font-size: 13px; outline: none; font-family: 'Inter', sans-serif;"></textarea>
                    </div>
                    <button type="submit" style="width: 100%; background: var(--accent-color); color: var(--bg-main); font-weight: bold; padding: 10px; border: none; border-radius: 4px; cursor: pointer; text-transform: uppercase; font-size: 11px; letter-spacing: 1px;">Kirim Pesan</button>
                </form>
            </div>

            <!-- List Pesan Terbaru -->
            <div>
                <h3 style="font-size: 16px; font-weight: bold; color: var(--text-main); margin-bottom: 16px;">Pesan Pengunjung Terbaru</h3>
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    {guestbookList && guestbookList.length > 0 ? (
                        guestbookList.map((item) => (
                            <div style="background: var(--bg-card); border: 1px solid var(--border-color); padding: 16px; border-radius: 6px;">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
                                    <strong style="font-size: 13px; color: var(--text-main);">{item.name}</strong>
                                    <span style="font-size: 10px; font-family: 'JetBrains Mono', monospace; color: var(--text-muted);">{new Date(item.created_at).toLocaleDateString()}</span>
                                </div>
                                <p style="font-size: 12px; color: var(--text-muted); line-height: 1.5;">{item.message}</p>
                            </div>
                        ))
                    ) : (
                        <p style="font-size: 12px; font-family: monospace; color: var(--text-muted);">Belum ada pesan di buku tamu.</p>
                    )}
                </div>
            </div>
        </div>
    </section>

    <!-- CONTACT -->
    <section id="contact" class="content-section reveal">
        <div class="contact-box">
            <span>GET IN TOUCH</span>
            <h2>Let's Build Something Amazing Together</h2>
            <p>Tertarik berdiskusi seputar arsitektur backend, otomasi sistem, atau kolaborasi profesional? Hubungi saya melalui tautan di bawah ini.</p>
            <div class="contact-buttons">
                <a href="mailto:aribanyoko@gmail.com" class="btn-action primary">✉️ Email Me</a>
                <a href="https://linkedin.com" target="_blank" class="btn-action secondary">💼 LinkedIn</a>
                <a href="https://wa.me/6281234567890" target="_blank" class="btn-action secondary">📞 WhatsApp</a>
            </div>
        </div>
    </section>

    <!-- SKRIP INTERAKTIF PENCARIAN & FILTER -->
    <script is:inline>
        document.addEventListener('astro:page-load', () => {
            const searchInput = document.getElementById('projectSearch');
            const filterButtons = document.querySelectorAll('.filter-btn');
            const projectCards = document.querySelectorAll('.project-card');

            if (searchInput && filterButtons.length > 0) {
                let currentTech = 'all';

                function filterProjects() {
                    const query = searchInput.value.toLowerCase().trim();

                    projectCards.forEach(card => {
                        const title = card.getAttribute('data-title');
                        const tech = card.getAttribute('data-tech');

                        const matchesSearch = title.includes(query) || tech.includes(query);
                        const matchesTech = currentTech === 'all' || tech.includes(currentTech);

                        if (matchesSearch && matchesTech) {
                            card.style.display = 'flex';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                }

                searchInput.addEventListener('input', filterProjects);

                filterButtons.forEach(btn => {
                    btn.addEventListener('click', () => {
                        filterButtons.forEach(b => {
                            b.style.backgroundColor = 'var(--bg-card)';
                            b.style.color = 'var(--text-muted)';
                            b.style.border = '1px solid var(--border-color)';
                            b.style.fontWeight = 'normal';
                        });
                        btn.style.backgroundColor = 'var(--accent-color)';
                        btn.style.color = 'var(--bg-main)';
                        btn.style.border = 'none';
                        btn.style.fontWeight = 'bold';

                        currentTech = btn.getAttribute('data-tech');
                        filterProjects();
                    });
                });
            }
        });
    </script>
</Layout>